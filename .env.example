# Use isso só localmente, pra rodar "npm run register" antes de subir na Discloud.
# Na Discloud, as variáveis reais vão coladas no painel (aba Variáveis), não aqui.

DISCORD_TOKEN=seu_token_do_bot
CLIENT_ID=id_da_aplicacao_discord
OWNER_ID=seu_id_de_usuario_discord
# Chave da API RX.SALAS (prefixo rxc_live_...). ROOM_API_KEY continua
# funcionando como alias, caso já esteja assim configurado na Discloud.
RX_API_KEY=rxc_live_sua_chave_aqui

# Access Token da sua conta Mercado Pago (Pix automático).
MP_ACCESS_TOKEN=seu_access_token_aqui
# Opcional — domínio usado no e-mail sintético do payer (discord-<id>@dominio).
# MP_PAYER_EMAIL_DOMAIN=ffzsalas.gg
STORE_INVITE=https://discord.gg/seu-link
STAFF_ROLE_ID=
TICKET_CHANNEL_ID=
